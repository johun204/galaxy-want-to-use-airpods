<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 그림자 -->
    <item android:left="3dp" android:top="4dp" android:right="3dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="7dp" android:right="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 흰색 카드 -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
</layer-list>
